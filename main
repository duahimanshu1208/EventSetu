\n            </div>\n            <button class=\"icon-btn\" type=\"button\" onclick=\"toggleBookmark(${item.id})\" aria-pressed=\"${item.bookmarked}\" aria-label=\"${item.bookmarked ? 'Remove bookmark' : 'Bookmark'}\">\n              ${bookmarkSvg(item.bookmarked)}\n            </button>\n          </div>\n\n          <h3>${escapeHtml(item.title)}</h3>\n\n          ${item.hasConflict ? `<button type=\"button\" class=\"conflict-chip\" onclick=\"openConflictModal(${item.id})\">Sources disagree. See details</button>` : ''}\n\n          <dl class=\"facts\">\n            <dt>When</dt><dd>${escapeHtml(item.deadline)}</dd>\n            <dt>Where</dt><dd>${escapeHtml(item.location)}</dd>\n          </dl>\n\n          <blockquote class=\"quote\">${escapeHtml(item.rawText)}</blockquote>\n        </div>\n        <div class=\"memo-foot\">\n          <span class=\"src\" title=\"${escapeHtml(item.source)}\">${escapeHtml(item.source)}</span>\n          <span class=\"foot-actions\">\n            <button type=\"button\" class=\"btn btn-link\" onclick=\"shareMemo(${item.id})\">Share</button>\n            <button type=\"button\" class=\"btn btn-link\" onclick=\"addToCalendar(${item.id})\">Add to calendar</button>\n            ${canEditItem(item) ? `<button type=\"button\" class=\"btn btn-link\" onclick=\"openEditModal(${item.id})\">Edit</button>` : ''}\n            ${(isAdmin && role === 'admin') ? `<button type=\"button\" class=\"btn btn-link btn-danger\" onclick=\"deleteMemo(${item.id})\">Delete</button>` : ''}\n          </span>\n        </div>\n      `;\n      grid.appendChild(card);\n    });\n  }\n\n  function updateStats() {\n    document.getElementById('statTotal').textContent = announcements.length;\n    document.getElementById('statUrgent').textContent = announcements.filter(a => a.urgent).length;\n    document.getElementById('statConflicts').textContent = announcements.filter(a => a.hasConflict).length;\n    document.getElementById('statBookmarks').textContent = announcements.filter(a => a.bookmarked).length;\n  }\n\n  function updateConflictBanner() {\n    const container = document.getElementById('conflictBannerContainer');\n    const conflicts = announcements.filter(a => a.hasConflict);\n    if (!conflicts.length) { container.innerHTML = ''; return; }\n    container.innerHTML = `\n      <div class=\"banner\">\n        <div>\n          <strong>${conflicts.length} ${conflicts.length === 1 ? 'memo has' : 'memos have'} conflicting information</strong>\n          <span>Chats gave different venues or times. Check before you head out.</span>\n        </div>\n        <button type=\"button\" class=\"btn\" onclick=\"openConflictModal(${conflicts[0].id})\">Review</button>\n      </div>`;\n  }\n\n  function filterAnnouncements() {\n    const query = document.getElementById('searchInput').value.toLowerCase();\n    const dept = document.getElementById('filterDept').value;\n    const year = document.getElementById('filterYear').value;\n    const type = document.getElementById('filterType').value;\n\n    const filtered = announcements.filter(item => {\n      const matchesQuery = !query ||\n        item.title.toLowerCase().includes(query) ||\n        item.location.toLowerCase().includes(query) ||\n        item.rawText.toLowerCase().includes(query);\n      const matchesDept = dept === 'ALL' || item.dept === dept || item.dept === 'General';\n      const matchesYear = year === 'ALL' || item.eligibility.includes(year) || item.eligibility.includes('All Years');\n      const matchesType = type === 'ALL' || item.type === type;\n      const matchesSociety = activeSociety === 'ALL' || item.society === activeSociety;\n      const matchesBookmark = !showOnlyBookmarked || item.bookmarked;\n      return matchesQuery && matchesDept && matchesYear && matchesType && matchesSociety && matchesBookmark;\n    });\n    renderAnnouncements(filtered);\n    renderBrowse();\n  }\n\n  function renderBrowse() {\n    const type = document.getElementById('filterType').value;\n    document.getElementById('catGrid').innerHTML = CATEGORIES.map(([t, d]) => {\n      const n = announcements.filter(a => a.type === t).length;\n      return '<button type=\"button\" class=\"chip-card\" aria-pressed=\"' + (type === t) + '\" onclick=\"pickType(\\'' + t + '\\')\"><strong>' + t + '</strong><span>' + n + ' memo' + (n === 1 ? '' : 's') + ' · ' + d + '</span></button>';\n    }).join('');\n    document.getElementById('socGrid').innerHTML = SOCIETIES.map(s => {\n      const n = announcements.filter(a => a.society === s).length;\n      return '<button type=\"button\" class=\"chip-card\" aria-pressed=\"' + (activeSociety === s) + '\" onclick=\"pickSociety(\\'' + s + '\\')\"><strong>' + s + '</strong><span>' + n + ' memo' + (n === 1 ? '' : 's') + '</span></button>';\n    }).join('');\n  }\n  function pickType(t) {\n    const sel = document.getElementById('filterType');\n    sel.value = sel.value === t ? 'ALL' : t;\n    filterAnnouncements();\n  }\n  function pickSociety(s) {\n    activeSociety = activeSociety === s ? 'ALL' : s;\n    filterAnnouncements();\n  }\n  function quickAdd(t) { openAddModal(); document.getElementById('parseType').value = t; }\n  function renderRoleSpace() {\n    const box = document.getElementById('roleSpace');\n    if (!isAdmin) { box.hidden = true; return; }\n    box.hidden = false;\n    box.innerHTML = role === 'admin'\n      ? '<div><h2>Admin space</h2><p>Full control: publish every memo type, edit and delete any memo.</p></div><div class=\"acts\"><button class=\"btn btn-primary\" type=\"button\" onclick=\"quickAdd(\\'Exam\\')\">Add exam</button><button class=\"btn\" type=\"button\" onclick=\"quickAdd(\\'Room Change\\')\">Add room change</button><button class=\"btn\" type=\"button\" onclick=\"openAddModal()\">Add memo</button></div>'\n      : '<div><h2>Organizer space</h2><p>Post and edit deadlines and events for your society. Deleting and other memo types are admin-only.</p></div><div class=\"acts\"><button class=\"btn btn-primary\" type=\"button\" onclick=\"quickAdd(\\'Deadline\\')\">Add deadline</button><button class=\"btn\" type=\"button\" onclick=\"quickAdd(\\'Cultural\\')\">Add cultural event</button><button class=\"btn\" type=\"button\" onclick=\"quickAdd(\\'Workshop\\')\">Add workshop</button></div>';\n  }\n\n  function toggleBookmarksFilter() {\n    showOnlyBookmarked = !showOnlyBookmarked;\n    document.getElementById('bookmarkFilterBtn').setAttribute('aria-pressed', String(showOnlyBookmarked));\n    filterAnnouncements();\n  }\n\n  function toggleBookmark(id) {\n    const item = announcements.find(a => a.id === id);\n    if (!item) return;\n    item.bookmarked = !item.bookmarked;\n    if (item.bookmarked) bookmarkIds.add(item.id); else bookmarkIds.delete(item.id);\n    saveBookmarks();\n    filterAnnouncements();\n    updateStats();\n    showToast(item.bookmarked ? 'Bookmarked' : 'Bookmark removed');\n  }\n\n  function canEditItem(item) {\n    return isAdmin && (role === 'admin' || (role === 'organizer' && ORGANIZER_TYPES.includes(item.type)));\n  }\n\n  function setModalMode(editing) {\n    document.getElementById('addTitle').textContent = editing ? 'Edit memo' : 'Add a memo';\n    document.getElementById('addSub').textContent = editing\n      ? 'Changes go live for everyone as soon as you save.'\n      : 'Paste a message from a group chat and fill in what the extractor misses.';\n    document.getElementById('saveBtn').textContent = editing ? 'Save changes' : 'Publish memo';\n  }\n\n  function resetForm() {\n    ['rawText', 'parseTitle', 'parseDeadline', 'parseLocation', 'parseEligibility', 'parseConflictNote'].forEach(id => document.getElementById(id).value = '');\n    ['parseType', 'parseSociety', 'parseDept'].forEach(id => document.getElementById(id).selectedIndex = 0);\n    document.getElementById('parseSource').value = 'WhatsApp batch group';\n    document.getElementById('parseUrgent').checked = false;\n    document.getElementById('parseConflict').checked = false;\n    document.getElementById('conflictNotesWrapper').hidden = true;\n  }\n\n  function openAddModal() {\n    if (editingId !== null) resetForm();\n    editingId = null;\n    setModalMode(false);\n    document.getElementById('addModal').hidden = false;\n    document.getElementById('rawText').focus();\n  }\n\n  function openEditModal(id) {\n    const m = announcements.find(a => a.id === id);\n    if (!m || !canEditItem(m)) return;\n    editingId = id;\n    setModalMode(true);\n    document.getElementById('rawText').value = m.rawText || '';\n    document.getElementById('parseTitle').value = m.title || '';\n    document.getElementById('parseType').value = m.type;\n    document.getElementById('parseSociety').value = m.society || '';\n    document.getElementById('parseDeadline').value = m.deadline === 'TBD' ? '' : m.deadline;\n    document.getElementById('parseLocation').value = m.location === 'TBD' ? '' : m.location;\n    document.getElementById('parseDept').value = m.dept;\n    document.getElementById('parseEligibility').value = m.eligibility || '';\n    document.getElementById('parseUrgent').checked = !!m.urgent;\n    document.getElementById('parseConflict').checked = !!m.hasConflict;\n    document.getElementById('conflictNotesWrapper').hidden = !m.hasConflict;\n    document.getElementById('parseConflictNote').value = m.conflictNote || '';\n    document.getElementById('parseSource').value = m.source || '';\n    document.getElementById('addModal').hidden = false;\n    document.getElementById('parseTitle').focus();\n  }\n  function closeAddModal() { document.getElementById('addModal').hidden = true; }\n\n  function loadSampleIntoParser() {\n    document.getElementById('rawText').value = \"URGENT: Prof. Meenakshi announced that the Compiler Design Quiz 2 is rescheduled to Friday at 4:00 PM in Lab 304 for Final Year CSE students. (Note: earlier notice said Lab 102).\";\n    parseRawText();\n  }\n\n  // Simple rule-based extraction from pasted chat text\n  function parseRawText() {\n    const raw = document.getElementById('rawText').value.trim();\n    if (!raw) { showToast('Paste a message first'); return; }\n    const t = raw.toLowerCase();\n\n    let title = \"General announcement\";\n    if (/(quiz|exam|midterm)/.test(t)) title = \"Exam and quiz schedule notice\";\n    else if (/(workshop|guest)/.test(t)) title = \"Workshop notice\";\n    else if (/(submission|deadline)/.test(t)) title = \"Submission deadline update\";\n    else if (/(audition|cultural)/.test(t)) title = \"Cultural event announcement\";\n\n    let type = \"Deadline\";\n    if (/(exam|quiz)/.test(t)) type = \"Exam\";\n    else if (/workshop/.test(t)) type = \"Workshop\";\n    else if (/(cultural|audition)/.test(t)) type = \"Cultural\";\n    else if (/(rescheduled|moved|hall)/.test(t)) type = \"Room Change\";\n\n    const venue = raw.match(/\\b(lab|hall|room|block|auditorium|seminar hall)\\s*[\\w-]+/i);\n    const day = raw.match(/\\b(monday|tuesday|wednesday|thursday|friday|saturday|sunday|tomorrow|today)\\b/i);\n    const time = raw.match(/\\b\\d{1,2}(:\\d{2})?\\s?(am|pm)\\b/i);\n\n    let dept = \"General\";\n    if (/\\bcse\\b/.test(t)) dept = \"CSE\";\n    else if (/\\bece\\b/.test(t)) dept = \"ECE\";\n    else if (/\\bmech\\b/.test(t)) dept = \"MECH\";\n\n    let eligibility = \"All Years\";\n    if (/final year/.test(t)) eligibility = \"Final Year Students\";\n    else if (/3rd year|third year/.test(t)) eligibility = \"3rd Year Students\";\n    else if (/2nd year|second year/.test(t)) eligibility = \"2nd Year Students\";\n    else if (/1st year|first year/.test(t)) eligibility = \"1st Year Students\";\n\n    const isUrgent = /(urgent|rescheduled)/.test(t);\n    const hasConflict = /(earlier notice|instead|said)/.test(t);\n\n    document.getElementById('parseTitle').value = title;\n    document.getElementById('parseType').value = (role === 'organizer' && !ORGANIZER_TYPES.includes(type)) ? 'Deadline' : type;\n    document.getElementById('parseDeadline').value = [day && day[0], time && time[0]].filter(Boolean).join(', ');\n    document.getElementById('parseLocation').value = venue ? venue[0] : '';\n    document.getElementById('parseDept').value = dept;\n    document.getElementById('parseEligibility').value = eligibility;\n    document.getElementById('parseUrgent').checked = isUrgent;\n    document.getElementById('parseConflict').checked = hasConflict;\n    document.getElementById('conflictNotesWrapper').hidden = !hasConflict;\n    document.getElementById('parseConflictNote').value = hasConflict ? \"The message refers to an earlier notice with different details.\" : '';\n\n    showToast('Details extracted. Check them before publishing.');\n  }\n\n  async function saveAnnouncement() {\n    const title = document.getElementById('parseTitle').value.trim() || \"Untitled memo\";\n    const memo = {\n      title,\n      type: document.getElementById('parseType').value,\n      society: document.getElementById('parseSociety').value,\n      deadline: document.getElementById('parseDeadline').value.trim() || \"TBD\",\n      location: document.getElementById('parseLocation').value.trim() || \"TBD\",\n      dept: document.getElementById('parseDept').value,\n      eligibility: document.getElementById('parseEligibility').value.trim() || \"All Years\",\n      urgent: document.getElementById('parseUrgent').checked,\n      hasConflict: document.getElementById('parseConflict').checked,\n      conflictNote: document.getElementById('parseConflictNote').value.trim(),\n      source: document.getElementById('parseSource').value.trim() || \"Student chat\",\n      rawText: document.getElementById('rawText').value.trim() || title\n    };\n    const editing = editingId !== null;\n\n    try {\n      const res = await fetch(editing ? '/api/memos?id=' + encodeURIComponent(editingId) : '/api/memos', {\n        method: editing ? 'PUT' : 'POST',\n        headers: { 'Content-Type': 'application/json', 'x-admin-password': adminPassword, 'x-role': role },\n        body: JSON.stringify(memo)\n      });\n      if (res.status === 401) {\n        isAdmin = false; adminPassword = ''; role = ''; applyAdminUi(); filterAnnouncements(); closeAddModal();\n        showToast('Session expired. Sign in again.');\n        return;\n      }\n      if (res.status === 403) {\n        showToast(editing ? 'Organizers can only edit deadlines and events.' : 'Organizers can only add deadlines and events.');\n        return;\n      }\n      if (res.status === 404 && editing) {\n        announcements = announcements.filter(a => a.id !== editingId);\n        editingId = null;\n        filterAnnouncements(); updateStats(); updateConflictBanner(); closeAddModal();\n        showToast('That memo was deleted by someone else.');\n        return;\n      }\n      if (!res.ok) throw new Error(res.status);\n      const saved = await res.json();\n      if (editing) {\n        announcements = announcements.map(a => a.id === saved.id ? { ...saved, bookmarked: a.bookmarked } : a);\n      } else {\n        announcements.unshift({ ...saved, bookmarked: false });\n      }\n    } catch (e) {\n      showToast(editing ? \"Couldn't save changes. Try again.\" : \"Couldn't publish. Try again.\");\n      return;\n    }\n\n    filterAnnouncements();\n    updateStats();\n    updateConflictBanner();\n    closeAddModal();\n    showToast(editing ? 'Changes saved' : 'Memo published');\n    resetForm();\n    editingId = null;\n  }\n\n  // Share: native share sheet on phones, copy-to-clipboard elsewhere\n  async function shareMemo(id) {\n    const item = announcements.find(a => a.id === id);\n    if (!item) return;\n    const url = location.origin + location.pathname + '#memo-' + id;\n    const message = item.title + '\\n' + item.deadline + ' · ' + item.location;\n    if (navigator.share) {\n      try { await navigator.share({ title: item.title, text: message, url }); } catch (e) { /* cancelled */ }\n      return;\n    }\n    try {\n      await navigator.clipboard.writeText(message + '\\n' + url);\n      showToast('Link copied');\n    } catch (e) {\n      window.prompt('Copy this link', url);\n    }\n  }\n\n  // Opening a shared link (…#memo-123) scrolls to that memo and highlights it\n  function focusFromHash() {\n    const m = location.hash.match(/^#memo-(\\d+)$/);\n    if (!m) return;\n    const el = document.getElementById('memo-' + m[1]);\n    if (!el) { showToast('That memo is no longer available'); return; }\n    el.scrollIntoView({ block: 'center' });\n    el.classList.add('flash');\n    setTimeout(() => el.classList.remove('flash'), 2800);\n  }\n\n  async function loadMemos() {\n    try { bookmarkIds = new Set(JSON.parse(localStorage.getItem('eventsetu-bookmarks') || '[]')); } catch (e) { bookmarkIds = new Set(); }\n    let list;\n    try {\n      const res = await fetch('/api/memos', { cache: 'no-store' });\n      if (!res.ok) throw new Error(res.status);\n      list = await res.json();\n      if (!Array.isArray(list)) throw new Error('bad response');\n    } catch (e) {\n      list = DEMO;\n      document.getElementById('demoNotice').hidden = false;\n    }\n    announcements = list.map(m => ({ ...m, bookmarked: bookmarkIds.has(m.id) }));\n    filterAnnouncements();\n    updateStats();\n    updateConflictBanner();\n    focusFromHash();\n  }\n\n  function saveBookmarks() {\n    try { localStorage.setItem('eventsetu-bookmarks', JSON.stringify([...bookmarkIds])); } catch (e) {}\n  }\n\n  function fillSocieties() { document.getElementById('parseSociety').innerHTML = '<option value=\"\">None (optional)</option>' + SOCIETIES.map(s => '<option>' + s + '</option>').join(''); }\n  fillSocieties();\n\n  function applyAdminUi() {\n    document.getElementById('addBtn').hidden = !isAdmin;\n    document.getElementById('adminBtn').textContent = (isAdmin && role === 'admin') ? 'Sign out' : 'Admin sign in';\n    document.getElementById('adminBtn').hidden = isAdmin && role === 'organizer';\n    document.getElementById('organizerBtn').textContent = (isAdmin && role === 'organizer') ? 'Sign out' : 'Organizer sign in';\n    document.getElementById('organizerBtn').hidden = isAdmin && role === 'admin';\n    document.body.dataset.role = isAdmin ? role : '';\n    renderRoleSpace();\n    const limited = isAdmin && role === 'organizer';\n    Array.from(document.getElementById('parseType').options).forEach(o => {\n      const blocked = limited && !ORGANIZER_TYPES.includes(o.value);\n      o.hidden = blocked; o.disabled = blocked;\n    });\n    const sel = document.getElementById('parseType');\n    if (limited && !ORGANIZER_TYPES.includes(sel.value)) sel.value = 'Deadline';\n  }\n\n  async function signIn(wanted) {\n    if (isAdmin) {\n      isAdmin = false; adminPassword = ''; role = '';\n      applyAdminUi(); filterAnnouncements();\n      return;\n    }\n    const pw = window.prompt(wanted === 'organizer' ? 'Organizer password' : 'Admin password');\n    if (!pw) return;\n    try {\n      const res = await fetch('/api/login', {\n        method: 'POST',\n        headers: { 'x-admin-password': pw, 'x-role': wanted }\n      });\n      if (res.ok) {\n        const data = await res.json();\n        isAdmin = true; adminPassword = pw; role = data.role || wanted;\n        applyAdminUi(); filterAnnouncements();\n        showToast('Signed in as ' + role);\n      } else if (res.status === 401) {\n        showToast('Wrong password');\n      } else {\n        showToast('Sign-in is not set up yet');\n      }\n    } catch (e) {\n      showToast(\"Couldn't reach the server\");\n    }\n  }\n  function adminToggle() { return signIn('admin'); }\n  function organizerToggle() { return signIn('organizer'); }\n\n  async function deleteMemo(id) {\n    if (!window.confirm('Delete this memo for everyone?')) return;\n    try {\n      const res = await fetch('/api/memos?id=' + encodeURIComponent(id), {\n        method: 'DELETE',\n        headers: { 'x-admin-password': adminPassword, 'x-role': role }\n      });\n      if (res.status === 403) { showToast('Only admins can delete memos.'); return; }\n      if (!res.ok) throw new Error(res.status);\n      announcements = announcements.filter(a => a.id !== id);\n      bookmarkIds.delete(id); saveBookmarks();\n      filterAnnouncements(); updateStats(); updateConflictBanner();\n      showToast('Memo deleted');\n    } catch (e) {\n      showToast(\"Couldn't delete. Try again.\");\n    }\n  }\n\n  function openConflictModal(id) {\n    const item = announcements.find(a => a.id === id);\n    if (!item) return;\n    document.getElementById('conflictEvent').textContent = item.title;\n    document.getElementById('conflictModalContent').innerHTML = `\n      <div class=\"compare\">\n        <div><span class=\"k\">Currently listed</span>${escapeHtml(item.location)}<br>${escapeHtml(item.deadline)}</div>\n        <div><span class=\"k\">Source</span>${escapeHtml(item.source)}</div>\n      </div>\n      <p class=\"note\">${escapeHtml(item.conflictNote || 'Two messages in the department chats gave different details.')}</p>\n    `;\n    document.getElementById('conflictModal').hidden = false;\n  }\n  function closeConflictModal() { document.getElementById('conflictModal').hidden = true; }\n\n  // Calendar export (.ics)\n  function icsEscape(s) { return String(s).replace(/\\\\/g, '\\\\\\\\').replace(/;/g, '\\\\;').replace(/,/g, '\\\\,').replace(/\\r?\\n/g, '\\\\n'); }\n  function icsStamp(d) {\n    const p = n => String(n).padStart(2, '0');\n    return `${d.getFullYear()}${p(d.getMonth() + 1)}${p(d.getDate())}T${p(d.getHours())}${p(d.getMinutes())}00`;\n  }\n\n  function addToCalendar(id) {\n    const item = announcements.find(a => a.id === id);\n    if (!item) return;\n\n    const start = new Date(item.deadline.replace(/\\s-\\s/, ' '));\n    const hasDate = !isNaN(start.getTime());\n    const lines = [\n      'BEGIN:VCALENDAR', 'VERSION:2.0', 'PRODID:-//EventSetu//EN',\n      'BEGIN:VEVENT',\n      `UID:${item.id}@eventsetu`,\n      `DTSTAMP:${icsStamp(new Date())}`,\n      ...(hasDate ? [`DTSTART:${icsStamp(start)}`, `DTEND:${icsStamp(new Date(start.getTime() + 3600000))}`] : []),\n      `SUMMARY:${icsEscape(item.title)}`,\n      `DESCRIPTION:${icsEscape(item.rawText)}`,\n      `LOCATION:${icsEscape(item.location)}`,\n      'END:VEVENT', 'END:VCALENDAR'\n    ];\n\n    const blob = new Blob([lines.join('\\r\\n')], { type: 'text/calendar;charset=utf-8' });\n    const link = document.createElement('a');\n    link.href = URL.createObjectURL(blob);\n    link.download = item.title.replace(/[^a-z0-9]/gi, '_').toLowerCase() + '.ics';\n    document.body.appendChild(link);\n    link.click();\n    document.body.removeChild(link);\n    setTimeout(() => URL.revokeObjectURL(link.href), 1000);\n\n    showToast(hasDate ? 'Calendar file downloaded' : \"Downloaded. The date wasn't recognized, so set it in your calendar.\");\n  }\n\n  // Theme\n  function syncThemeButton() {\n    const dark = document.documentElement.getAttribute('data-theme') === 'dark';\n    const btn = document.getElementById('themeBtn');\n    btn.textContent = dark ? 'Light' : 'Dark';\n    btn.setAttribute('aria-label', dark ? 'Switch to light theme' : 'Switch to dark theme');\n  }\n\n  function toggleTheme() {\n    const next = document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';\n    document.documentElement.setAttribute('data-theme', next);\n    try { localStorage.setItem('eventsetu-theme', next); } catch (e) {}\n    syncThemeButton();\n  }\n\n  function showToast(message) {\n    const toast = document.getElementById('toast');\n    toast.textContent = message;\n    toast.classList.add('show');\n    clearTimeout(toastTimer);\n    toastTimer = setTimeout(() => toast.classList.remove('show'), 2800);\n  }\n\n  function escapeHtml(str) {\n    if (!str) return '';\n    return String(str).replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\").replace(/\"/g, \"&quot;\").replace(/'/g, \"&#039;\");\n  }\n</script>\n</body>\n</html>\n";

const TYPES = ['Deadline', 'Exam', 'Cultural', 'Workshop', 'Room Change'];
const DEPTS = ['CSE', 'ECE', 'MECH', 'General'];
const MAX_MEMOS = 200;
const SOCIETIES = ['Coding Club', 'Cultural Society', 'Robotics Club', 'Literary Society', 'Sports Council', 'Entrepreneurship Cell', 'Campus-wide'];
// Organizers may only add or edit deadlines and events; admins can do every type and delete.
const ORGANIZER_TYPES = ['Deadline', 'Cultural', 'Workshop'];

const json = (data, status = 200) =>
  new Response(JSON.stringify(data), {
    status,
    headers: { 'Content-Type': 'application/json', 'Cache-Control': 'no-store' }
  });

const text = (v, max) => (typeof v === 'string' ? v.trim().slice(0, max) : '');

function safeEqual(given, real) {
  if (!real || given.length !== real.length) return false;
  let diff = 0;
  for (let i = 0; i < real.length; i++) diff |= given.charCodeAt(i) ^ real.charCodeAt(i);
  return diff === 0;
}

// Returns 'admin', 'organizer', or null. A role with no password secret set is disabled.
function getRole(request, env) {
  const given = request.headers.get('x-admin-password') || '';
  const wanted = request.headers.get('x-role') || '';
  if (wanted !== 'organizer' && safeEqual(given, env.ADMIN_PASSWORD)) return 'admin';
  if (wanted !== 'admin' && safeEqual(given, env.ORGANIZER_PASSWORD)) return 'organizer';
  return null;
}

function cleanMemo(body) {
  const title = text(body.title, 120) || 'Untitled memo';
  return {
    title,
    type: TYPES.includes(body.type) ? body.type : 'Deadline',
    deadline: text(body.deadline, 60) || 'TBD',
    location: text(body.location, 100) || 'TBD',
    dept: DEPTS.includes(body.dept) ? body.dept : 'General',
    eligibility: text(body.eligibility, 60) || 'All Years',
    society: SOCIETIES.includes(body.society) ? body.society : '',
    urgent: body.urgent === true,
    hasConflict: body.hasConflict === true,
    conflictNote: text(body.conflictNote, 300),
    source: text(body.source, 80) || 'Student chat',
    rawText: text(body.rawText, 1000) || title
  };
}

async function readMemos(env) {
  const list = await env.MEMOS.get('memos', 'json');
  return Array.isArray(list) ? list : [];
}

async function readBody(request) {
  try {
    const body = await request.json();
    return body && typeof body === 'object' ? body : null;
  } catch (e) {
    return null;
  }
}

async function handleMemos(request, env) {
  if (!env.MEMOS) return json({ error: 'KV binding MEMOS is not configured' }, 500);

  if (request.method === 'GET') {
    return json(await readMemos(env));
  }

  const role = getRole(request, env);
  if (!role) return json({ error: 'Unauthorized' }, 401);

  if (request.method === 'POST') {
    const body = await readBody(request);
    if (!body) return json({ error: 'Invalid body' }, 400);

    if (role === 'organizer' && !ORGANIZER_TYPES.includes(body.type)) {
      return json({ error: 'Organizers can only add Deadline, Cultural or Workshop memos' }, 403);
    }

    const memo = { id: Date.now(), ...cleanMemo(body) };
    const list = await readMemos(env);
    list.unshift(memo);
    await env.MEMOS.put('memos', JSON.stringify(list.slice(0, MAX_MEMOS)));
    return json(memo, 201);
  }

  if (request.method === 'PUT') {
    const id = Number(new URL(request.url).searchParams.get('id'));
    if (!Number.isFinite(id)) return json({ error: 'Missing id' }, 400);
    const body = await readBody(request);
    if (!body) return json({ error: 'Invalid body' }, 400);

    const list = await readMemos(env);
    const i = list.findIndex(m => m.id === id);
    if (i === -1) return json({ error: 'Memo not found' }, 404);

    if (role === 'organizer' && (!ORGANIZER_TYPES.includes(list[i].type) || !ORGANIZER_TYPES.includes(body.type))) {
      return json({ error: 'Organizers can only edit Deadline, Cultural or Workshop memos' }, 403);
    }

    list[i] = { id, ...cleanMemo(body) };
    await env.MEMOS.put('memos', JSON.stringify(list));
    return json(list[i]);
  }

  if (request.method === 'DELETE') {
    if (role !== 'admin') return json({ error: 'Only admins can delete memos' }, 403);
    const id = Number(new URL(request.url).searchParams.get('id'));
    if (!Number.isFinite(id)) return json({ error: 'Missing id' }, 400);
    const list = await readMemos(env);
    await env.MEMOS.put('memos', JSON.stringify(list.filter(m => m.id !== id)));
    return json({ ok: true });
  }

  return json({ error: 'Method not allowed' }, 405);
}

export default {
  async fetch(request, env) {
    const url = new URL(request.url);

    if (url.pathname === '/api/memos') return handleMemos(request, env);

    if (url.pathname === '/api/login' && request.method === 'POST') {
      const wanted = request.headers.get('x-role') === 'organizer' ? 'organizer' : 'admin';
      const secret = wanted === 'organizer' ? env.ORGANIZER_PASSWORD : env.ADMIN_PASSWORD;
      if (!secret) return json({ error: wanted + ' sign-in is not configured' }, 503);
      const role = getRole(request, env);
      return role ? json({ ok: true, role }) : json({ error: 'Unauthorized' }, 401);
    }

    if (url.pathname === '/' || url.pathname === '/index.html') {
      return new Response(PAGE, {
        headers: {
          'Content-Type': 'text/html; charset=UTF-8',
          'X-Content-Type-Options': 'nosniff',
          'Cache-Control': 'no-cache'
        }
      });
    }

    return new Response('Not found', { status: 404 });
  }
};
